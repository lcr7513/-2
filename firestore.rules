rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // Students collection
    match /students/{studentId} {
      allow read, write: if true; // Allows educational class app use
    }

    // Books subcollection or collection
    match /students/{studentId}/books/{bookId} {
      allow read, write: if true;
    }

    // Activities subcollection or collection
    match /students/{studentId}/activities/{activityId} {
      allow read, write: if true;
    }

    // Settings / Class metadata
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Fallback rule for open educational client mode
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
